# DeployForge backend configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# --- App ---
# Async PostgreSQL DSN. Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://deployforge:deployforge@localhost:5433/deployforge
# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-long-random-string
# Signing algorithm for JWTs.
JWT_ALGORITHM=HS256
# How long an issued access token stays valid, in minutes (1440 = 24h).
JWT_EXPIRE_MINUTES=1440

# --- Token encryption (for storing GitHub tokens at rest) ---
# Fernet key used to encrypt GitHubConnection.access_token_enc.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-fernet-key

# --- GitHub OAuth App ---
# From https://github.com/settings/developers -> OAuth Apps.
# The client secret stays on the backend and is never sent to the browser.
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
# Must exactly match the Authorization callback URL registered on the OAuth App.
GITHUB_CALLBACK_URL=http://localhost:8000/github/callback
# Scopes requested. `repo` lists and downloads repositories (including private
# ones); `workflow` lets DeployForge add its build workflow to a repository;
# `read:packages` lets the server pull the images that workflow builds.
GITHUB_OAUTH_SCOPES=repo,workflow,read:packages

# --- Frontend ---
# Allowed CORS origin, and where the OAuth callback sends the browser back to.
FRONTEND_ORIGIN=http://localhost:3000

# --- Misc ---
# "development" or "production". Development enables API docs at /docs.
APP_ENV=development
# Parent directory for temporary repo downloads (Task 4). Empty = system temp.
REPO_WORKDIR=

# --- Where builds run ---
# "local": on this machine with docker / pack (the default, for a laptop).
# "actions": in GitHub Actions, in each student's repository. Needs a public
# PUBLIC_API_URL, because GitHub calls the server back when a build finishes.
BUILD_BACKEND=local
PUBLIC_API_URL=http://localhost:8000
# On a laptop, `scripts/dev.ps1 tunnel` publishes the console and the API on
# your static ngrok domain and sets PUBLIC_API_URL=https://<domain>/backend.
# NGROK_DOMAIN=your-name.ngrok-free.dev
# Signs GitHub webhook deliveries. With it and an https PUBLIC_API_URL, every
# app gets a webhook and a push deploys it. `dev.ps1 tunnel` generates one.
# GITHUB_WEBHOOK_SECRET=
# The shared workflow every student's workflow file calls.
CI_WORKFLOW=Pritesh-30/DeployForge/.github/workflows/deployforge-build.yml@main

# --- Builds on this machine (BUILD_BACKEND=local) ---
# The pack CLI, from https://buildpacks.io. Requires Docker on the same host.
# pack 0.40+ is required for Docker 29 — older versions use a Docker API
# version the daemon rejects.
PACK_BINARY=pack
# The Cloud Native Buildpacks builder image used for every build.
PACK_BUILDER=paketobuildpacks/builder-jammy-base
# Node version used when a repository does not pin one in package.json.
# Unset, the buildpack installs the newest release, and Node 24 needs a shared
# library no Paketo run image ships — the image builds and then dies on boot.
DEFAULT_NODE_VERSION=22.*
# Override the run image the built app runs on. Empty = the builder's default.
PACK_RUN_IMAGE=
# Prefix for built image tags: <namespace>/<user>-<repo>:<commit>
IMAGE_NAMESPACE=deployforge
# A build still running after this many seconds is killed.
BUILD_TIMEOUT_SECONDS=1800
# Where build logs are written. Empty = beside the repo working directory.
BUILD_LOG_DIR=

# --- Image registry ---
# Built images are pushed here, so a build produces a stored artifact rather
# than a tag that only exists on the machine that built it.
REGISTRY_HOST=localhost:5000
REGISTRY_PUSH=true

# --- Runtime ---
# The bridge network app containers share with the router. Apps publish no
# host ports; the router is the only way in.
EDGE_NETWORK=deployforge_edge
# Apps are served at <subdomain>.<APP_DOMAIN>. Browsers resolve *.localhost to
# the loopback address with no DNS entry, which is what makes this work.
APP_DOMAIN=localhost
ROUTER_CONTAINER=deployforge-traefik
# Shared secret the router presents when polling for its routing table.
# Must match the token in the Traefik --providers.http.endpoint URL.
TRAEFIK_PROVIDER_TOKEN=change-me-router-token
# The Traefik certificate resolver for HTTPS. Leave empty on a laptop — Let's
# Encrypt cannot issue for *.localhost. docker-compose.yml sets it on a server.
TLS_CERT_RESOLVER=
# Hostnames for the console and API when they run behind the router too (as in
# docker-compose.yml). Empty on a laptop, where they are reached directly.
CONSOLE_HOST=
API_HOST=

# Per-app resource caps, so one runaway app cannot take the machine down.
APP_MEMORY_LIMIT=512m
APP_CPU_LIMIT=1.0
APP_PIDS_LIMIT=256
# How long to wait before checking a started container is still alive.
APP_START_GRACE_SECONDS=6

# How many apps one account may run at once. Admins raise it per student.
DEFAULT_MAX_DEPLOYMENTS=3

# --- Redis ---
# The build queue, rate limits, metrics and cached GitHub responses. Required:
# without it builds cannot be queued. See the README for the one-line container.
# 127.0.0.1 rather than localhost: on Windows localhost tries IPv6 first.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Build queue ---
# Builds that run at once on this server. Each pins a core and a few GB of RAM.
# The starting value: administrators change it live on the Build queue page.
BUILD_CONCURRENCY=2
# The most the Build queue page will allow.
BUILD_CONCURRENCY_MAX=8

# --- Automatic rollback ---
# For this many seconds after a new version goes live, a crash puts the
# previous version back. 0 turns it off.
AUTO_ROLLBACK_WINDOW_SECONDS=300
# Run the queue's workers inside the API. Set false when `python -m app.worker`
# runs them as separate processes instead.
WORKER_EMBEDDED=true
# A worker that stops renewing its lease for this long is presumed dead, and
# its build goes back on the queue for another worker.
QUEUE_LEASE_SECONDS=60
# Attempts per build. Only platform faults (network, GitHub 5xx, Docker not
# answering) are retried — never a build that failed because of the project.
QUEUE_MAX_ATTEMPTS=3

# --- Rate limits ---
# Deploys and rollbacks per account: a burst, then a steady rate.
RATE_LIMIT_DEPLOYS_PER_HOUR=30
RATE_LIMIT_DEPLOY_BURST=6

# --- Metrics ---
METRICS_ENABLED=true
METRICS_INTERVAL_SECONDS=15
METRICS_RETENTION_HOURS=24
# "router": probe apps through the router (a laptop). "direct": probe the
# container over the shared network (when the API runs beside the apps).
PROBE_MODE=router
ROUTER_PROBE_URL=http://127.0.0.1:80

# --- Image mirroring (Actions builds) ---
# Keep a copy of every Actions-built image in REGISTRY_HOST and run from it.
MIRROR_CI_IMAGES=true
# Then delete GitHub's copy, if the student granted delete:packages.
CI_CLEANUP_GITHUB_PACKAGES=true

# --- AI diagnosis (optional) ---
# With a key, failed deployments get an "Explain with AI" button.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
