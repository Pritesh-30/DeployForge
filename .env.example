# Configuration for `docker compose` (docker-compose.yml), i.e. the server.
# For running the backend straight on your laptop, see backend/.env.example.
#
# Copy to `.env` beside docker-compose.yml. `infra/deploy.sh` generates the
# secrets for you on first deploy; you only fill in the GitHub and domain parts.

# The base domain. The console is served at console.<DOMAIN>, the API at
# api.<DOMAIN>, and every app at <app>.<DOMAIN>.
#
# Without a domain of your own, sslip.io resolves any name containing an IP to
# that IP: with a server at 20.1.2.3, use 20-1-2-3.sslip.io.
DOMAIN=20-1-2-3.sslip.io

# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# GitHub OAuth App for this server. Its callback URL must be exactly
#   https://api.<DOMAIN>/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secrets. Generate once and never change TOKEN_ENCRYPTION_KEY afterwards:
# every stored GitHub token and environment variable is encrypted with it.
POSTGRES_PASSWORD=
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
TRAEFIK_PROVIDER_TOKEN=
